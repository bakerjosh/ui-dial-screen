<screen>
	<styles>
		<style
			name="screen_bg"
			bg_color="0x000000"
			bg_opa="100%"
			text_color="0xffffff"
			pad_all="34"
		/>
		<style name="muted_text" text_color="0xc8f8ff" text_opa="80%" text_font="geist_semibold_12" />
		<style name="title_text" text_color="0xffffff" text_font="geist_semibold_28" />
		<style name="option_text" text_color="0xffffff" text_font="geist_bold_16" />
		<style
			name="selected_option"
			width="100%"
			height="86"
			bg_color="0x0e0e0e"
			bg_opa="100%"
			border_color="0x00fff0"
			border_width="2"
			radius="8"
			pad_all="18"
			text_color="0xffffff"
		/>
	</styles>

	<view flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center" style_pad_row="14">
		<style name="screen_bg" />

		<lv_label text="Question 1 / 5" align="center">
			<style name="muted_text" />
		</lv_label>

		<lv_label text="Innovation" align="center">
			<style name="title_text" />
		</lv_label>

		<lv_label text="How innovative did this feel?" align="center">
			<style name="muted_text" />
		</lv_label>

		<lv_label text="2" align="center">
			<style name="muted_text" />
		</lv_label>

		<div style_flex_cross_place="center">
			<style name="selected_option" />
			<lv_label text="3" align="center">
				<style name="option_text" />
			</lv_label>
		</div>

		<lv_label text="4" align="center">
			<style name="muted_text" />
		</lv_label>

		<lv_label text="3 of 5" align="center">
			<style name="muted_text" />
		</lv_label>

		<row width="100%" style_flex_main_place="space_between" style_flex_cross_place="center" style_pad_top="8">
			<button label="Prev" width="92" />
			<button label="OK" width="112" />
			<button label="Next" width="92" />
		</row>
	</view>
</screen>
