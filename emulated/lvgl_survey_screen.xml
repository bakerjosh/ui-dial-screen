<screen>
	<styles>
		<style
			name="screen_bg"
			width="480"
			height="480"
			bg_color="0x000000"
			bg_opa="100%"
			border_width="0"
			pad_all="0"
		/>
		<style
			name="safe_column"
			width="344"
			height="402"
			x="68"
			y="42"
			bg_opa="0"
			border_width="0"
			pad_all="0"
			layout="flex"
			flex_flow="column"
			flex_main_place="center"
			flex_cross_place="center"
			pad_row="8"
		/>
		<style name="round_screen_outline" width="480" height="480" bg_opa="0" border_color="0xffffff" border_opa="6%" border_width="1" radius="240" pad_all="0" />
		<style name="round_safe_outline" width="432" height="432" x="24" y="24" bg_opa="0" border_color="0xffffff" border_opa="4%" border_width="1" radius="216" pad_all="0" />
		<style name="eyebrow_text" width="344" text_color="0x00fff0" text_opa="90%" text_font="geist_semibold_12" text_align="center" text_letter_space="1" />
		<style name="title_text" width="344" text_color="0xffffff" text_font="geist_semibold_28" text_align="center" />
		<style name="body_text" width="300" text_color="0xc8f8ff" text_opa="62%" text_font="geist_regular_14" text_align="center" text_line_space="2" />
		<style name="muted_option" width="160" text_color="0xc8f8ff" text_opa="42%" text_font="geist_bold_16" text_align="center" />
		<style name="selected_panel" width="118" height="90" bg_opa="0" border_color="0x00fff0" border_opa="92%" border_width="3" radius="16" pad_all="4" layout="flex" flex_flow="column" flex_main_place="center" flex_cross_place="center" />
		<style name="selected_text" width="104" text_color="0xffffff" text_font="geist_light_60" text_align="center" />
		<style name="progress_text" width="344" text_color="0xc8f8ff" text_opa="85%" text_font="geist_semibold_12" text_align="center" />
		<style name="controls_row" width="248" height="38" bg_opa="0" border_width="0" pad_all="0" layout="flex" flex_flow="row" flex_main_place="space_between" flex_cross_place="center" />
		<style name="control_button" width="62" height="38" bg_opa="0" border_width="0" radius="8" text_color="0xc8f8ff" text_opa="55%" text_font="geist_bold_16" />
		<style name="ok_button" width="64" height="38" bg_opa="0" border_width="0" radius="8" text_color="0x00fff0" text_font="geist_bold_16" />
	</styles>

	<view name="fish_selection_screen">
		<style name="screen_bg" />
		<view name="round_screen_outline"><style name="round_screen_outline" /></view>
		<view name="round_safe_outline"><style name="round_safe_outline" /></view>
		<view name="survey_safe_area">
			<style name="safe_column" />
			<lv_label name="question_count" text="Question 1 / 5"><style name="eyebrow_text" /></lv_label>
			<lv_label name="question_title" text="Overall Comparison"><style name="title_text" /></lv_label>
			<lv_label name="question_body" text="Think back to the last events you attended from other laboratories, especially in the same area. On a scale of 1 to 5, how would you rate this TCD event compared to those from other colleges?" long_mode="wrap"><style name="body_text" /></lv_label>
			<lv_label name="previous_option" text="2"><style name="muted_option" /></lv_label>
			<view name="selected_option">
				<style name="selected_panel" />
				<lv_label name="selected_option_label" text="3" long_mode="wrap"><style name="selected_text" /></lv_label>
			</view>
			<lv_label name="next_option" text="4"><style name="muted_option" /></lv_label>
			<lv_label name="option_progress" text="3 of 5"><style name="progress_text" /></lv_label>
			<row name="survey_controls">
				<style name="controls_row" />
				<lv_button name="previous_button"><remove_style_all /><style name="control_button" /><lv_label text="Prev" align="center" /></lv_button>
				<lv_button name="confirm_button"><remove_style_all /><style name="ok_button" /><lv_label text="OK" align="center" /></lv_button>
				<lv_button name="next_button"><remove_style_all /><style name="control_button" /><lv_label text="Next" align="center" /></lv_button>
			</row>
		</view>
	</view>
</screen>
